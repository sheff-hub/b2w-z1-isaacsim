# ---- runtime files
project/instruction.txt
project/target.txt
vln/out/
nav2/b2w_nav2_params.yaml
scenes/nurec/

# ---- Python
__pycache__/
*.pyc
.venv/

# ---- never commit credentials
*token*
*.env
.env*

# ---- MoveIt: made by moveit/make_config.py from the robot assets
moveit/config/z1.urdf
