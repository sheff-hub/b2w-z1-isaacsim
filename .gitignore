# ---- this machine (template: config.example.yaml). Anchored: the reconstruction folders' config.yaml are
# their defaults and belong in git (unanchored, this line kept reconstruction/config.yaml out of the repo)
/config.yaml

# ---- third-party checkouts, cloned by setup.sh
repos/

# ---- large assets: a release download (setup.sh), see robots_usd/README.md
robots_usd/*
!robots_usd/README.md
dist/

# ---- outputs of runs
renders/*
!renders/README.md
datasets/*
