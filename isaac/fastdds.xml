<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Phase 1 networking fix. Disables built-in transports (including Shared Memory,
  which Docker's PID/IPC namespaces block) and forces plain UDPv4 so ROS 2 topics
  cross the container/host boundary reliably.

  Unchanged from the version validated on the office workstation.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles" >
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_transport_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>UdpTransport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
